{
  "name": "content-parser",
  "version": "1.0.0",
  "description": "High-performance website and asset parser MCP server and CLI for AI agents",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "bin": {
    "content-parser": "./bin/content-parser.js",
    "cp-mcp": "./bin/content-parser.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node bin/content-parser.js start",
    "serve:clone": "node site-clone/serve.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/test/parser.test.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "web-scraper",
    "asset-parser",
    "playwright",
    "ai-agents",
    "claude",
    "cursor",
    "codex",
    "antigravity",
    "frontharness"
  ],
  "author": "sorinqu-org",
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "cheerio": "^1.0.0",
    "commander": "^13.1.0",
    "fast-glob": "^3.3.3",
    "picocolors": "^1.1.1",
    "playwright": "^1.50.1",
    "smol-toml": "^1.3.1",
    "turndown": "^7.2.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/turndown": "^5.0.6",
    "tsup": "^8.4.0",
    "tsx": "^4.23.13",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
